# Front controller API (§4.1)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
# Hanya index.php yang boleh dieksekusi langsung
<FilesMatch "\.(php|phtml|phar)$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>
Options -Indexes
