# media/ — hanya file statis hasil re-encode/sanitasi (§8.2). Tidak ada eksekusi skrip.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule php_module>
  php_flag engine off
</IfModule>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php5 .phar .pl .py .cgi .sh
  RemoveType .php .phtml .php5 .phar
</IfModule>
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|json|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options nosniff
  <FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
  </FilesMatch>
  # nama file ber-hash → immutable
  <FilesMatch "\.(webp|png|jpe?g|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
